{
  "name": "tangotiempo",
  "version": "1.23.0",
  "private": true,
  "proxy": "http://localhost:3010",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && next-sitemap",
    "start": "next start -p 3001",
    "eslint": "clear && npx eslint  . --fix",
    "format": "prettier --write .",
    "snyk": "snyk test",
    "prep": "prettier --write . && npm run eslint && npm run build",
    "cleanall": "npm cache clean --force && rm -rf node_modules package-lock.json && npm install && depcheck && npm run prep",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:local": "CYPRESS_BASE_URL=http://localhost:3001 cypress run",
    "cypress:run:test": "CYPRESS_BASE_URL=https://test.tangotiempo.com cypress run",
    "cypress:run:readonly": "cypress run --spec 'cypress/e2e/01-readonly/**'",
    "cypress:run:smoke": "CYPRESS_BASE_URL=https://tangotiempo.com cypress run --spec 'cypress/e2e/01-readonly/**'",
    "test:e2e": "npm run cypress:run:local",
    "test:e2e:headed": "CYPRESS_BASE_URL=http://localhost:3001 cypress run --headed",
    "test:e2e:chrome": "CYPRESS_BASE_URL=http://localhost:3001 cypress run --browser chrome",
    "test:e2e:report": "npm run cypress:run:local && npm run report:merge && npm run report:generate",
    "report:merge": "mochawesome-merge cypress/reports/*.json > cypress/reports/combined-report.json",
    "report:generate": "marge cypress/reports/combined-report.json --reportDir cypress/reports/html --inline --inlineAssets --reportTitle \"Cypress E2E Test Report - Run ${GITHUB_RUN_NUMBER:-Local}\" --reportPageTitle \"DEVL Test Results\"",
    "report:clean": "rm -rf cypress/reports"
  },
  "engines": {
    "node": "=22.x"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.25.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/rrule": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@microsoft/applicationinsights-react-js": "^17.3.4",
    "@microsoft/applicationinsights-web": "^3.3.4",
    "@mui/icons-material": "^6.1.5",
    "@mui/lab": "^6.0.0-beta.19",
    "@mui/material": "^6.1.5",
    "@mui/system": "^6.1.5",
    "@mui/x-date-pickers": "^7.28.3",
    "@vercel/analytics": "^1.5.0",
    "@visx/axis": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "@visx/zoom": "^3.12.0",
    "axios": "^1.7.7",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "debounce": "^2.2.0",
    "depcheck": "^1.4.7",
    "dompurify": "^3.1.7",
    "firebase": "^11.6.0",
    "install": "^0.13.0",
    "js-cookie": "^3.0.5",
    "jsdom": "^25.0.1",
    "leaflet": "^1.9.4",
    "luxon": "^3.5.0",
    "next": "14.2.35",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "pandoc": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "rrule": "^2.8.1",
    "slugify": "^1.6.6",
    "uuid": "^11.0.2",
    "validator": "^13.12.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "cypress": "^14.3.2",
    "cypress-fail-fast": "^7.1.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.1",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.11.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.0",
    "prettier": "^3.3.3"
  },
  "resolutions": {
    "cross-spawn": "7.0.5"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.3"
  }
}
