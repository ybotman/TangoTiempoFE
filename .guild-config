# Guild Configuration File Example
# Copy this to .guild-config in your project root and update with your values

# Startup Config Prompts : uTNC, uGS, uGR, uGC, uJC, uJA

# -----  Trigger a new Concatenated Files
createNewConcatenatedTriggerFile  = "./.TriggerConcatenated"

# ----- STARTUP
useGuildStartup = "YES"
useGuildCustomStartup = "NO"

# ----- LIFECYCLE
useGuildLifeCycle = "YES"
useCustomGuildLifeCycles = "NO"

# ----- ROLES
useGuildRoles = "YES"
useCustomRoles  = "NO"
GuildRolesPath = "public/"
CustomGuildRolesPath = ""


# ----- COMMANDS
useGuildCommands = "YES"
useCustomGuildCommands  = "NO"

# ----- JIRA
useJIRA = "YES"
useJjiraCLI = "YES" 
useJiraAPI = "NO"
JiraConfigPath = "./"

JiraCLIBase = "jira --config ./.jira.d/config.yml"
#JiraCLIBase = "jira"


# ----- BRANCH
useBranchLogic = "YES"
DEVELOPMENT="DEVL"
TESTING="TEST"
PRODUCTION="PROD"
DEFAULT_BRANCH="DEVL"

# ----- GIT
useGuildGitStandards = "YES"
useGuildGitBranchPromotions = "NO"
GuildGITStandardsPath ""
DEVL—><branch>—>DEVL


# <origin> GIT Lifecycle
DEVL—>TEST—>PROD
# Over arching GIT strategy (Fill in your own words like “Dont MERGE or PR”_
GIT_General_Stategy = ‘follow the GIT-Strategy.md’



# ----- Application PLAYBOOKS
useApplicationPlaybooks = "YES"
ApplicationPlaybooksPath = ""
ApplicationCodeBuildingStrategyPath = '/'
ApplicationCodeTestingStrategyPath ='/'


# Application Playbooks (Optional)
# Define paths to application-specific documentation
# Can be either a folder (all .md files will be concatenated) or a single file

Appl_Playbook_TangoTiempo = ‘public/Playbook/tango-tiempo/‘
Appl_Playbook_MasterCalendar = ‘public/Playbook/MasterCalendar/‘
Appl_Playbook_CalendarBE = ‘public/Playbook/calendar-be/‘
